# Copy to .env.local for local work. On Vercel add the same two names under
# Project -> Settings -> Environment Variables, then redeploy.
# Find both in Supabase: Project Settings -> API.
# The anon key is meant to be public; it is protected by the database rules in supabase/schema.sql.
# NEVER put the "service_role" key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Turn on online payment (Paynow) ONLY after the payment function is deployed and its secrets are set.
# VITE_ONLINE_PAYMENTS=on
